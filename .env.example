# Copier ce fichier en .env et adapter les valeurs. NE JAMAIS versionner .env
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# --- Base de données MySQL ---
DB_NAME=aesm
DB_USER=aesm_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# Mettre DB_ENGINE=sqlite uniquement pour un test local rapide sans MySQL
# DB_ENGINE=sqlite

# --- E-mail (production) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="AESM <no-reply@aesm.mg>"

# --- Paiements ---
# "simulation" (par défaut, aucun argent réel) puis "tokipay" (voir docs/PAIEMENTS_TOKIPAY.md)
PAYMENT_PROVIDER=simulation
# Mettre 0 dès le passage à un vrai prestataire : la fausse page de paiement disparaît
PAYMENT_SIMULATION_ENABLED=1
# Secret de signature du webhook Tokipay (vide = webhook refusé)
WEBHOOK_SECRET_TOKIPAY=
