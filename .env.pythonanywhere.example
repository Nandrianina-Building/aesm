# Modèle de .env pour PythonAnywhere (V1 de TEST). setup.sh le copie en .env et remplit les valeurs automatiques.
DJANGO_SECRET_KEY=__SECRET__
DJANGO_ALLOWED_HOSTS=__USER__.pythonanywhere.com
SITE_URL=https://__USER__.pythonanywhere.com

# Base SQLite (un simple fichier db.sqlite3, aucune installation)
DB_ENGINE=sqlite

# --- Paiement : SIMULATION (V1 de test, aucun argent réel) ---
PAYMENT_PROVIDER=simulation
PAYMENT_SIMULATION_ENABLED=1
ALLOW_PAYMENT_SIMULATION_IN_PROD=1

# --- E-mail réel via Gmail (à remplir : voir le guide, partie B) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=A_REMPLIR@gmail.com
EMAIL_HOST_PASSWORD=A_REMPLIR
DEFAULT_FROM_EMAIL="AESM <A_REMPLIR@gmail.com>"

# --- Sécurité / réseau ---
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=3600
TRUST_X_FORWARDED_FOR=1

# --- Comptes de démonstration : mot de passe PRIVÉ (généré automatiquement par setup.sh) ---
DEMO_PASSWORD=__DEMOPWD__
DEMO_MEMBERS=30
